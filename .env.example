# Copy this file to .env.local (git-ignored) and fill it in.
#
# Firebase web config: Firebase console → Settings → General → Your apps → tp-escape-web → Config.
# These values are not secret: every Firebase web app ships them to the browser, and access is
# controlled by firestore.rules. Real secrets never go in VITE_ variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true: talk to the local emulators (npm run emulators) instead of the real project.
# Handy for trying multiplayer without touching real data or the free-tier quota.
VITE_USE_EMULATORS=false
