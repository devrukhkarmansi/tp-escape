{
  "name": "tp-escape",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sample": "node --experimental-strip-types --no-warnings scripts/sample-game.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "dev:crew": "VITE_USE_EMULATORS=true firebase emulators:exec --only auth,firestore --project demo-tp-escape \"vite --host --port 5173 --strictPort\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-tp-escape",
    "test:rules": "firebase emulators:exec --only firestore --project demo-tp-escape \"vitest run --config vitest.rules.config.ts\"",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.30.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
